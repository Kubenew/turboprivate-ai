# TurboPrivate AI Configuration

## Inference
TURBO_INFERENCE__MODEL_NAME=llama3-8b-int4
TURBO_INFERENCE__BACKEND=auto
TURBO_INFERENCE__GPU_TYPE=auto
TURBO_INFERENCE__MAX_BATCH_SIZE=32
TURBO_INFERENCE__MAX_WAIT_MS=50
TURBO_INFERENCE__KV_CACHE_SIZE=8192

## Safety
TURBO_SAFETY__ENABLED=true
TURBO_SAFETY__PRE_FLIGHT=true
TURBO_SAFETY__POST_FLIGHT=true
TURBO_SAFETY__BLOCKING_THRESHOLD=0.7

## Memory & RAG
TURBO_MEMORY__ENABLED=false
TURBO_MEMORY__EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TURBO_MEMORY__STORAGE_PATH=./data/memory
TURBO_MEMORY__CHUNK_SIZE=512
TURBO_MEMORY__CHUNK_OVERLAP=64

## Auth
TURBO_AUTH__ENABLED=true
TURBO_AUTH__JWT_SECRET=change-me-in-production
TURBO_AUTH__JWT_ALGORITHM=HS256
TURBO_AUTH__JWT_EXPIRE_MINUTES=60

## Observability
TURBO_OBSERVABILITY__TRACING=true
TURBO_OBSERVABILITY__METRICS=true
TURBO_OBSERVABILITY__LOGGING_LEVEL=INFO

## Cluster
TURBO_CLUSTER__NAME=turbo-cluster
TURBO_CLUSTER__PROVIDER=bare-metal
TURBO_CLUSTER__K3S_VERSION=v1.30.0+k3s1

## Paths
TURBO_DATA_DIR=./data
TURBO_LOG_DIR=./logs

## Celery (workers)
CELERY_BROKER_URL=redis://localhost:6379/0
