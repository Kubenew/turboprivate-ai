# .env template — copy to .env and fill in your values
HANA_HOST=your-hana-host.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=YOUR_USER
HANA_PASSWORD=YOUR_PASSWORD
HANA_DATABASE=HANA_DB
HANA_SSL_VALIDATE=false

TURBOPRIVATE_BASE_URL=http://localhost:8000/v1
TURBOPRIVATE_API_KEY=anything
TURBOPRIVATE_MODEL=llama-3.1-8b

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_TABLE=SAP_DOCS_VECTOR
